{
  "expo": {
    "name": "MIRApp",
    "slug": "mirapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mira-logo.png",
    "scheme": "mirapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/mira-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.interventionnetwork.mirapp",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MIRApp needs microphone access to record anonymous audio reports.",
        "NSLocationWhenInUseUsageDescription": "MIRApp captures your location once when you submit a report to help responders reach the right area."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mira-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.interventionnetwork.mirapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "MIRApp needs microphone access to record anonymous audio reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MIRApp captures your location once when you submit a report to help responders reach the right area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ad5f25e-5608-434b-93d2-305ffcc08aba"
      }
    }
  }
}
